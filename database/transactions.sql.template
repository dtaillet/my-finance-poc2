-- Transactions extracted from CA20250519_114826.ofx (OFX format)

CREATE TABLE IF NOT EXISTS transactions (
    fitid           TEXT PRIMARY KEY,   -- OFX FITID
    account_id      TEXT NOT NULL,      -- OFX ACCTID
    account_type    TEXT NOT NULL,      -- CHECKING / CREDITCARD
    dtposted        DATE NOT NULL,      -- OFX DTPOSTED
    trnamt          NUMERIC(12,2) NOT NULL, -- OFX TRNAMT
    name            TEXT,               -- OFX NAME / payee
    memo            TEXT,               -- OFX MEMO
    currency        TEXT
);

