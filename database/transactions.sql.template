CREATE TABLE IF NOT EXISTS imports (
    import_id       TEXT PRIMARY KEY,   -- file identifier
    file_name       TEXT NOT NULL,      -- imported file name
    import_date     DATE NOT NULL,      -- date of the import
    comment         TEXT                -- free-text comment
);

